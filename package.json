{
  "publisher": "cerrda",
  "name": "index-badge",
  "displayName": "Index Badge",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.4.1",
  "description": "为 index.* 文件添加可自定义的徽章标记，快速识别项目入口文件",
  "author": "Cerrda <cerrda728@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Cerrda/index-badge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cerrda/index-badge"
  },
  "bugs": {
    "url": "https://github.com/Cerrda/index-badge/issues"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./dist/index.js",
  "icon": "res/icon.png",
  "files": [
    "LICENSE.md",
    "dist/*",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [],
    "configuration": {
      "type": "object",
      "title": "Index Badge",
      "properties": {
        "indexBadge.badge": {
          "type": "string",
          "default": "🌟",
          "description": "自定义 index.* 文件的徽章图标"
        },
        "indexBadge.tooltip": {
          "type": "string",
          "default": "index file",
          "description": "鼠标悬停时显示的提示文本"
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --external vscode",
    "dev": "nr build --watch --sourcemap",
    "prepare": "nr update",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "nr build",
    "release": "bumpp",
    "ext:package": "vsce package --no-dependencies",
    "ext:publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@antfu/ni": "^23.3.1",
    "@types/node": "^22.19.7",
    "@types/vscode": "^1.108.1",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "ovsx": "^0.10.8",
    "pnpm": "^10.28.2",
    "reactive-vscode": "^0.2.22",
    "taze": "^19.9.2",
    "tsdown": "^0.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vscode-ext-gen": "^1.5.1",
    "vsxpub": "^0.1.3"
  }
}
